# Copy to /etc/mediaserver/scrutiny-notify.env on the host (chmod 600,
# root:root). NEVER commit the real file -- it must not be baked into the
# image. Loaded by scrutiny.container via:
#   EnvironmentFile=-/etc/mediaserver/scrutiny-notify.env
# (the leading "-" means Scrutiny still starts fine if this file is absent).

# shoutrrr-format notification URL for Scrutiny's SMART failure alerts.
# Example uses ntfy.sh; replace CHANGE_ME_TOPIC with a private topic name.
SCRUTINY_WEB_NOTIFY_URLS=ntfy://ntfy.sh/CHANGE_ME_TOPIC
