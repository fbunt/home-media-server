# Restic / Backblaze B2 backup configuration
# Copy to /etc/mediaserver/restic.env (NOT committed) and fill in real values.
# chmod 0600 recommended since this file holds credentials.

# B2 bucket to hold the restic repository. Bucket must already exist in B2.
RESTIC_REPOSITORY=b2:CHANGE_ME_BUCKET:media-server

# Backblaze B2 application key id/key (create an app key scoped to the bucket above).
B2_ACCOUNT_ID=CHANGE_ME
B2_ACCOUNT_KEY=CHANGE_ME

# Password protecting the restic repository encryption. Generate with e.g.
#   openssl rand -base64 32
# and store it safely -- losing it means losing access to all snapshots.
RESTIC_PASSWORD=CHANGE_ME

# healthchecks.io (or compatible) ping URL for backup success/failure monitoring.
HEALTHCHECKS_URL=https://hc-ping.com/CHANGE_ME-UUID
