# Copy to /etc/mediaserver/plex.env on the host (chmod 600, root:root).
# NEVER commit the real file -- it is git-ignored and must not be baked
# into the image.

# Claim token for linking this server to your Plex account. Get a fresh one
# (valid for only 4 minutes) from https://plex.tv/claim just before applying.
PLEX_CLAIM=claim-CHANGE_ME

# Local timezone for the container (Plex also gets TZ from the quadlet's
# Environment= directly; override here only if it needs to differ).
TZ=America/Denver
